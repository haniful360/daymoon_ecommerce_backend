// ============================================================================
// 4. PRODUCTS, TIERED PRICING, VARIANTS & CUSTOMIZATIONS
// ============================================================================

model Product {
  id                   String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sellerId             String                @map("seller_id") @db.Uuid
  categoryId           String                @map("category_id") @db.Uuid
  title                String                @db.VarChar(255)
  slug                 String                @unique @db.VarChar(255)
  description          String                @db.Text
  moq                  Int                   @default(10)
  samplePrice          Decimal?              @map("sample_price") @db.Decimal(10, 2)
  keyAttributes        Json?                 @default("{}") @map("key_attributes")
  images               String[]              @default([])
  status               ProductStatus         @default(PUBLISHED)
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller               SellerProfile         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tieredPricings       TieredPricing[]
  variants             ProductVariant[]
  customizationOptions CustomizationOption[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  reviews              Review[]

  @@index([sellerId], map: "idx_products_seller")
  @@index([categoryId], map: "idx_products_category")
  @@index([status], map: "idx_products_status")
  @@map("products")
}

model TieredPricing {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  minQuantity Int      @map("min_quantity")
  maxQuantity Int?     @map("max_quantity")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQuantity], map: "unique_product_tier")
  @@index([productId], map: "idx_tiered_pricings_product")
  @@map("tiered_pricings")
}

model ProductVariant {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId     String      @map("product_id") @db.Uuid
  colorName     String?     @map("color_name") @db.VarChar(50)
  colorCode     String?     @map("color_code") @db.VarChar(20)
  sizeLabel     String?     @map("size_label") @db.VarChar(50)
  sku           String?     @unique @db.VarChar(100)
  imageUrl      String?     @map("image_url") @db.VarChar(500)
  stockQuantity Int         @default(0) @map("stock_quantity")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId], map: "idx_variants_product")
  @@map("product_variants")
}

model CustomizationOption {
  id                     String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId              String   @map("product_id") @db.Uuid
  optionType             String   @map("option_type") @db.VarChar(150)
  additionalPricePerUnit Decimal  @default(0.00) @map("additional_price_per_unit") @db.Decimal(10, 2)
  minOrderRequired       Int      @default(1000) @map("min_order_required")

  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "idx_customizations_product")
  @@map("customization_options")
}
