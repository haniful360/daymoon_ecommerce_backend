// Product, Images, Tiered Pricing & OEM Customization

enum CustomizationType {
  CUSTOM_LOGO
  CUSTOM_PACKAGING
  GRAPHIC_CUSTOMIZATION
  OEM_FULL_DESIGN
}

model Product {
  id               String                 @id @default(uuid())
  sellerProfileId  String
  categoryId       String
  title            String
  slug             String                 @unique
  sku              String?
  description      String                 @db.Text
  moq              Int                    @default(1)
  samplePrice      Decimal?               @db.Decimal(10, 2)
  leadTimeDays     Int                    @default(14)
  originCountry    String
  portOfDispatch   String?
  packagingDetails String?                @db.Text
  isCustomizable   Boolean                @default(false)
  isActive         Boolean                @default(true)
  viewsCount       Int                    @default(0)
  ordersCount      Int                    @default(0)
  ratingAvg        Decimal                @default(0.0) @db.Decimal(3, 2)
  ratingCount      Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  sellerProfile    SellerProfile          @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  category         Category               @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  tieredPrices     TieredPrice[]
  customizations   ProductCustomization[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          Review[]

  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  url         String
  isThumbnail Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model TieredPrice {
  id          String   @id @default(uuid())
  productId   String
  minQuantity Int
  maxQuantity Int?
  unitPrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("tiered_prices")
}

model ProductCustomization {
  id                String            @id @default(uuid())
  productId         String
  customizationType CustomizationType
  minMoq            Int               @default(100)
  extraCostPerUnit  Decimal           @default(0.00) @db.Decimal(10, 2)
  description       String?
  createdAt         DateTime          @default(now())

  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_customizations")
}

