// ============================================================================
// 9. REVIEWS & RATINGS
// ============================================================================

model Review {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId         String?       @map("order_id") @db.Uuid
  buyerId         String        @map("buyer_id") @db.Uuid
  sellerId        String        @map("seller_id") @db.Uuid
  productId       String?       @map("product_id") @db.Uuid
  rating          Int
  comment         String?       @db.Text
  sellerReply     String?       @map("seller_reply") @db.Text
  sellerRepliedAt DateTime?     @map("seller_replied_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  buyer           User          @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  seller          SellerProfile @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sellerId], map: "idx_reviews_seller")
  @@index([productId], map: "idx_reviews_product")
  @@map("reviews")
}
