// Orders, Order Items, and Milestone Production Tracking

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PRODUCTION
  QA_INSPECTION
  READY_FOR_DISPATCH
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id               String               @id @default(uuid())
  orderNumber      String               @unique
  buyerId          String
  sellerProfileId  String
  totalAmount      Decimal              @db.Decimal(12, 2)
  commissionRate   Decimal              @default(5.00) @db.Decimal(5, 2)
  commissionAmount Decimal              @default(0.00) @db.Decimal(12, 2)
  sellerNetAmount  Decimal              @default(0.00) @db.Decimal(12, 2)
  paymentStatus    PaymentStatus        @default(PENDING)
  orderStatus      OrderStatus          @default(PENDING_PAYMENT)
  incoterm         Incoterm             @default(FOB)
  destinationPort  String?
  shippingAddress  Json
  notes            String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  buyer            User                 @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerProfile    SellerProfile        @relation("SellerOrders", fields: [sellerProfileId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  reviews          Review[]

  @@map("orders")
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  productId            String
  productTitle         String
  productSku           String?
  quantity             Int
  unitPrice            Decimal  @db.Decimal(10, 2)
  subtotal             Decimal  @db.Decimal(12, 2)
  customizationDetails Json?
  createdAt            DateTime @default(now())

  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  previousStatus  OrderStatus?
  newStatus       OrderStatus
  note            String?
  updatedByUserId String
  createdAt       DateTime     @default(now())

  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

