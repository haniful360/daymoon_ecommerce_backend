// ============================================================================
// 3. SELLER PROFILES
// ============================================================================

model SellerProfile {
  id                    String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String               @unique @map("user_id") @db.Uuid
  businessName          String               @map("business_name") @db.VarChar(255)
  businessType          String               @map("business_type") @db.VarChar(100)
  businessDescription   String?              @map("business_description") @db.Text
  country               String               @db.VarChar(100)
  storeLogo             String?              @map("store_logo") @db.VarChar(500)
  storeBanner           String?              @map("store_banner") @db.VarChar(500)
  socialLinks           Json?                @default("{}") @map("social_links")
  shippingRegions       String[]             @default(["NATIONAL"]) @map("shipping_regions")
  returnPolicy          String?              @default("7 Days") @map("return_policy") @db.VarChar(100)
  taxId                 String?              @map("tax_id") @db.VarChar(100)
  bankDetails           Json                 @map("bank_details") // Required: bank account details / wire / payout account
  isVerified            Boolean              @default(false) @map("is_verified")
  verificationDocuments Json?                @default("[]") @map("verification_documents")
  yearsInBusiness       Int?                 @default(1) @map("years_in_business")
  factorySize           String?              @map("factory_size") @db.VarChar(100)
  rdStaffCount          String?              @map("rd_staff_count") @db.VarChar(100)
  tradeTerms            String[]             @default(["FOB", "EXW"]) @map("trade_terms")
  averageRating         Decimal              @default(0.00) @map("average_rating") @db.Decimal(3, 2)
  totalReviews          Int                  @default(0) @map("total_reviews")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions         SellerSubscription[]
  products              Product[]
  orderItems            OrderItem[]          @relation("SellerOrderItems")
  payoutRequests        PayoutRequest[]      @relation("SellerPayoutRequests")
  rfqQuotes             RfqQuote[]           @relation("SellerRfqQuotes")
  reviews               Review[]             @relation("SellerReviews")

  @@index([businessName], map: "idx_seller_profiles_business_name")
  @@index([averageRating(sort: Desc)], map: "idx_seller_profiles_rating")
  @@map("seller_profiles")
}
