// Seller, Factory and Verification Documents Models

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentType {
  BUSINESS_LICENSE
  TAX_CERTIFICATE
  FACTORY_INSPECTION
  ISO_CERTIFICATE
  CE_CERTIFICATE
  BANK_STATEMENT
  EXPORT_LICENSE
  OTHER
}

model SellerProfile {
  id                    String             @id @default(uuid())
  userId                String             @unique
  companyName           String
  storeSlug             String             @unique
  businessType          String
  yearEstablished       Int?
  totalEmployees        String?
  registeredCapital     String?
  annualRevenue         String?
  operationalAddress    String
  city                  String
  state                 String
  country               String
  website               String?
  logoUrl               String?
  bannerUrl             String?
  businessDescription   String             @db.Text
  verificationStatus    VerificationStatus @default(PENDING)
  rejectionReason       String?
  verifiedAt            DateTime?
  currentTier           MembershipTier     @default(FREE)
  subscriptionExpiresAt DateTime?
  onboardingStep        Int                @default(1)
  isOnboardingComplete  Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  factoryDetail         FactoryDetail?
  documents             SellerDocument[]
  subscriptions         Subscription[]
  products              Product[]
  orders                Order[]            @relation("SellerOrders")
  quotes                Quote[]
  reviews               Review[]           @relation("SellerReviews")
  reviewReplies         ReviewReply[]
  payoutRequests        PayoutRequest[]

  @@map("seller_profiles")
}

model FactoryDetail {
  id                   String        @id @default(uuid())
  sellerProfileId      String        @unique
  factorySizeSqMeters  Float?
  productionLinesCount Int           @default(1)
  annualOutputValue    String?
  mainEquipment        String?       @db.Text
  rdStaffCount         Int           @default(0)
  qcStaffCount         Int           @default(0)
  oemExperienceYears   Int           @default(0)
  leadTimeDaysAvg      Int           @default(15)
  factoryAddress       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sellerProfile        SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@map("factory_details")
}

model SellerDocument {
  id              String        @id @default(uuid())
  sellerProfileId String
  documentType    DocumentType
  documentName    String
  documentNumber  String?
  fileUrl         String
  issueDate       DateTime?
  expiryDate      DateTime?
  isAudited       Boolean       @default(false)
  auditNotes      String?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@map("seller_documents")
}

