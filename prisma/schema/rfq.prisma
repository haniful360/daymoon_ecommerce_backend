// RFQs (Request for Quotations), Technical Drawings & Factory Quotes

enum RfqStatus {
  OPEN
  UNDER_REVIEW
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
  CLOSED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Rfq {
  id                 String          @id @default(uuid())
  rfqNumber          String          @unique
  buyerId            String
  categoryId         String
  title              String
  description        String          @db.Text
  targetQuantity     Int
  targetUnitPrice    Decimal?        @db.Decimal(10, 2)
  incoterm           Incoterm        @default(FOB)
  destinationPort    String?
  targetDeliveryDate DateTime?
  status             RfqStatus       @default(OPEN)
  expiryDate         DateTime
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  buyer              User            @relation("BuyerRfqs", fields: [buyerId], references: [id], onDelete: Cascade)
  category           Category        @relation(fields: [categoryId], references: [id])
  attachments        RfqAttachment[]
  quotes             Quote[]

  @@map("rfqs")
}

model RfqAttachment {
  id            String   @id @default(uuid())
  rfqId         String
  fileName      String
  fileUrl       String
  fileType      String?
  fileSizeBytes Int?
  createdAt     DateTime @default(now())

  rfq           Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@map("rfq_attachments")
}

model Quote {
  id                 String        @id @default(uuid())
  quoteNumber        String        @unique
  rfqId              String
  sellerProfileId    String
  unitPrice          Decimal       @db.Decimal(10, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  moqOffered         Int
  sampleLeadDays     Int?
  productionLeadDays Int
  incotermOffered    Incoterm      @default(FOB)
  shippingPort       String?
  paymentTerms       String?
  validUntil         DateTime
  status             QuoteStatus   @default(SUBMITTED)
  sellerNotes        String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  rfq                Rfq           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sellerProfile      SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  items              QuoteItem[]

  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(12, 2)

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_items")
}

