// ============================================================================
// 8. RFQ (REQUEST FOR QUOTATION) & BIDDING ENGINE
// ============================================================================

model Rfq {
  id                     String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  buyerId                String        @map("buyer_id") @db.Uuid
  categoryId             String        @map("category_id") @db.Uuid
  leadTitle              String        @map("lead_title") @db.VarChar(255)
  minBudget              Decimal?      @map("min_budget") @db.Decimal(12, 2)
  maxBudget              Decimal?      @map("max_budget") @db.Decimal(12, 2)
  targetQuantity         Int           @map("target_quantity")
  description            String        @db.Text
  expectedDeliveryDate   DateTime      @map("expected_delivery_date") @db.Date
  additionalRequirements String?       @map("additional_requirements") @db.Text
  attachmentUrls         String[]      @default([]) @map("attachment_urls")
  status                 RfqStatusType @default(OPEN)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyer                  User          @relation("BuyerRfqs", fields: [buyerId], references: [id], onDelete: Cascade)
  category               Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  quotes                 RfqQuote[]

  @@index([buyerId], map: "idx_rfqs_buyer")
  @@index([categoryId], map: "idx_rfqs_category")
  @@index([status], map: "idx_rfqs_status")
  @@map("rfqs")
}

model RfqQuote {
  id                   String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  rfqId                String          @map("rfq_id") @db.Uuid
  sellerId             String          @map("seller_id") @db.Uuid
  offeredUnitPrice     Decimal         @map("offered_unit_price") @db.Decimal(10, 2)
  totalQuotePrice      Decimal         @map("total_quote_price") @db.Decimal(12, 2)
  deliveryTimelineDays Int             @map("delivery_timeline_days")
  notes                String?         @db.Text
  status               QuoteStatusType @default(PENDING)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rfq                  Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  seller               SellerProfile   @relation("SellerRfqQuotes", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([rfqId, sellerId], map: "unique_seller_rfq_quote")
  @@index([rfqId], map: "idx_rfq_quotes_rfq")
  @@index([sellerId], map: "idx_rfq_quotes_seller")
  @@map("rfq_quotes")
}
