# PostgreSQL Database Connection URL (Docker Container mapped to port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/daymoon_db?schema=public"
DB_PORT=5433

# JWT Authentication Secrets
JWT_SECRET="your-jwt-secret-key-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-here"

# Server Configuration (Backend on Port 5000)
PORT=5000
NODE_ENV=development
