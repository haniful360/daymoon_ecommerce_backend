<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Your Verification Code - Daymoon</title>
  </head>
  <body
    style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;"
  >
    <table
      width='100%'
      border='0'
      cellspacing='0'
      cellpadding='0'
      style='background-color: #f3f4f6; padding: 40px 10px;'
    >
      <tr>
        <td align='center'>
          <table
            width='100%'
            border='0'
            cellspacing='0'
            cellpadding='0'
            style='max-width: 580px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);'
          >

            <!-- Header with Gradient & Logo -->
            <tr>
              <td
                style='background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); padding: 32px 24px; text-align: center;'
              >
                <h1
                  style='color: #ffffff; font-size: 26px; font-weight: 700; margin: 0; letter-spacing: 0.5px;'
                >DAYMOON</h1>
                <p
                  style='color: #dbeafe; font-size: 13px; margin: 6px 0 0 0; text-transform: uppercase; letter-spacing: 1.5px;'
                >B2B Wholesale & Factory Sourcing</p>
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td style='padding: 36px 32px;'>
                <h2
                  style='color: #111827; font-size: 20px; font-weight: 600; margin: 0 0 12px 0;'
                >Verify Your Email Address</h2>

                <p
                  style='color: #4b5563; font-size: 15px; line-height: 24px; margin: 0 0 24px 0;'
                >
                  Hello
                  <strong>{{name}}</strong>,<br />
                  Thank you for joining Daymoon B2B Marketplace. Please use the
                  verification code below to complete your Buyer account
                  registration.
                </p>

                <!-- OTP Code Display Card -->
                <table
                  width='100%'
                  border='0'
                  cellspacing='0'
                  cellpadding='0'
                  style='margin: 28px 0;'
                >
                  <tr>
                    <td
                      align='center'
                      style='background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 10px; padding: 22px;'
                    >
                      <span
                        style="font-family: 'Courier New', Courier, monospace; font-size: 38px; font-weight: 700; letter-spacing: 8px; color: #1e3a8a; display: block;"
                      >
                        {{otp}}
                      </span>
                      <span
                        style='display: block; font-size: 12px; color: #64748b; margin-top: 8px; font-weight: 500;'
                      >
                        Expires in
                        {{expiresInMinutes}}
                        minutes
                      </span>
                    </td>
                  </tr>
                </table>

                <!-- Expiry & Security Notes -->
                <p
                  style='color: #6b7280; font-size: 14px; line-height: 22px; margin: 0 0 16px 0;'
                >
                  This code will expire in
                  <strong>{{expiresInMinutes}} minutes</strong>. For your
                  security, never share this code with anyone. Daymoon
                  representatives will never ask for your verification code.
                </p>

                <p
                  style='color: #9ca3af; font-size: 13px; line-height: 20px; margin: 0; padding-top: 16px; border-top: 1px solid #e5e7eb;'
                >
                  If you did not request this email, you can safely ignore it.
                  No account will be created without this verification code.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style='background-color: #f9fafb; padding: 20px 24px; text-align: center; border-top: 1px solid #f3f4f6;'
              >
                <p style='color: #9ca3af; font-size: 12px; margin: 0 0 6px 0;'>
                  &copy; 2026 Daymoon B2B E-Commerce Marketplace. All rights
                  reserved.
                </p>
                <p style='color: #9ca3af; font-size: 11px; margin: 0;'>
                  Empowering Global Wholesale Trade & Direct Factory Sourcing
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
